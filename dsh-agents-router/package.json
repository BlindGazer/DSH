{
  "name": "@kalex/dsh-agents-router",
  "version": "2.0.0",
  "description": "Project-aware rules and skills routing for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./node": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "package.json"
  ],
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Agents Router",
        "ru": "Маршрутизатор правил и skills"
      },
      "summary": {
        "en": "Project-aware rules and skills routing for DeepSeek Harness",
        "ru": "Маршрутизация правил и skills проекта для DeepSeek Harness"
      },
      "category": "agent"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-release.mjs",
    "prepack": "node scripts/build.mjs && node scripts/verify-release.mjs",
    "pack:release": "node scripts/build.mjs && node scripts/verify-release.mjs && pnpm pack",
    "test": "node scripts/build.mjs && node scripts/test.js && node scripts/verify-release.mjs",
    "check": "node scripts/build.mjs && node scripts/test.js && node scripts/verify-release.mjs"
  },
  "keywords": ["dsh", "agent", "rules", "skills"],
  "author": "kalex.developer@gmail.com",
  "license": "ISC",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "esbuild": "^0.28.2"
  },
  "packageManager": "pnpm@11.28.5"
}
