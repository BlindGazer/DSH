{
  "name": "@kalex/dsh-plugins",
  "version": "2.0.0",
  "private": true,
  "description": "Reference monorepo for DeepSeek Harness (DSH) plugins and shared UI/core library",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/typecheck.ts",
    "lint": "node scripts/lint.ts",
    "format": "biome format --write --config-path=configs/biome.json packages scripts configs",
    "fix": "node scripts/fix.ts",
    "check": "node scripts/check.ts",
    "verify": "pnpm -r run verify && node scripts/verify-release-content.ts",
    "verify:tree-shaking": "node scripts/verify-tree-shaking.ts",
    "verify:code-sharing": "node scripts/verify-code-sharing.ts",
    "demo-core": "pnpm --filter @kalex/dsh-core demo --host 127.0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "0.28.2",
    "magic-string": "^1.4.5",
    "oxc-transform-react": "0.156.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "sass": "^1.108.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
