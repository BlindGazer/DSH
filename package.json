{
  "name": "@kalex/dsh-plugins",
  "version": "2.0.0",
  "private": true,
  "description": "Reference monorepo for DeepSeek Harness (DSH) plugins and shared UI/core library",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "oxlint -c configs/oxlint.json --ignore-pattern \"**/lib/**\" --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/node_modules/**\" packages scripts && biome check --config-path=configs/biome.json packages scripts",
    "format": "biome format --write --config-path=configs/biome.json packages scripts configs",
    "fix": "node scripts/fix.mjs",
    "check": "node scripts/check.mjs",
    "verify": "pnpm -r run verify",
    "verify:tree-shaking": "node scripts/verify-tree-shaking.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "magic-string": "^0.30.21",
    "oxc-transform-react": "^0.157.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "sass": "^1.107.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^3.2.0"
  }
}
