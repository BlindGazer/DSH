{
  "name": "@kalex/dsh-proxy-provider",
  "version": "2.0.0",
  "description": "Selective HTTP/HTTPS/SOCKS5 proxy routing per model provider for DeepSeek Harness",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./node": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "docs",
    "assets",
    "package.json"
  ],
  "dsh": {
    "plugin": {
      "schemaVersion": 1,
      "displayName": {
        "en": "Model Provider Proxy",
        "ru": "Прокси для провайдеров моделей",
        "zh-CN": "模型提供商代理"
      },
      "summary": {
        "en": "Selective HTTP/HTTPS/SOCKS5 proxy profiles and routing per model provider.",
        "ru": "Выборочная маршрутизация HTTP/HTTPS/SOCKS5 прокси для провайдеров моделей.",
        "zh-CN": "按模型提供商配置和绑定 HTTP/HTTPS/SOCKS5 代理。"
      },
      "category": "network"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "vite build --config ../../configs/packages/dsh-proxy-provider/vite.config.ts",
    "build:host": "vite build --config ../../configs/packages/dsh-proxy-provider/vite.config.host.ts",
    "test": "vitest run --config ../../configs/packages/dsh-proxy-provider/vitest.config.ts",
    "test:watch": "vitest --config ../../configs/packages/dsh-proxy-provider/vitest.config.ts",
    "verify": "node scripts/verify-release.mjs",
    "check": "pnpm run build && pnpm run test && pnpm run verify"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "proxy",
    "socks5",
    "providers"
  ],
  "author": "kalex.developer@gmail.com",
  "license": "ISC",
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "undici": "8.12.3",
    "react": "^18.0.0 || ^19.0.0",
    "react-compiler-runtime": "^1.0.0"
  }
}
